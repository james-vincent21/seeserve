{
  "name": "SeeServe · transactional email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "seeserve-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Hub webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "seeserve-email"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-seeserve-secret'] }}",
              "rightValue": "={{ $env.SEESERVE_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ ['reservation_confirmed', 'reservation_cancelled', 'queue_ticket', 'admin_login_link'].includes($json.body.template) }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Secret and template allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "fromEmail": "Dhaka Table House <no-reply@example.com>",
        "toEmail": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body.text }}\n\n— Dhaka Table House\nThis email was sent because of a booking or sign-in request. We never send marketing without your consent.",
        "options": {}
      },
      "name": "Send email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [480, -80],
      "notes": "Connect an SMTP credential in n8n (for Gmail: smtp.gmail.com:465 with an app password)."
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { \"delivered\": true } }}", "options": {} },
      "name": "Respond ok",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, -80]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { \"delivered\": false } }}", "options": { "responseCode": 403 } },
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 120]
    }
  ],
  "connections": {
    "Hub webhook": { "main": [[{ "node": "Secret and template allowed?", "type": "main", "index": 0 }]] },
    "Secret and template allowed?": {
      "main": [
        [{ "node": "Send email (SMTP)", "type": "main", "index": 0 }],
        [{ "node": "Reject", "type": "main", "index": 0 }]
      ]
    },
    "Send email (SMTP)": { "main": [[{ "node": "Respond ok", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "none", "saveDataErrorExecution": "none" },
  "active": false
}
