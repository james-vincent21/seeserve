{
  "name": "restaurant-vision",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @restaurant-vision/api\" \"npm run dev -w @restaurant-vision/web\"",
    "dev:api": "npm run dev -w @restaurant-vision/api",
    "dev:web": "npm run dev -w @restaurant-vision/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
