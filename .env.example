POSTGRES_DB=restaurant_vision
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant_dev_only
DATABASE_URL=postgresql://restaurant:restaurant_dev_only@localhost:5433/restaurant_vision
API_PORT=4000
API_SERVER_URL=http://localhost:4000

# Public URLs used in emails and CORS (dashboard :3000, landing site :3001)
WEB_ORIGIN=http://localhost:3000
LANDING_ORIGIN=http://localhost:3001
PUBLIC_DASHBOARD_URL=http://localhost:3000
PUBLIC_LANDING_URL=http://localhost:3001

# CCTV demo
INFERENCE_MODE=ultralytics
ULTRALYTICS_API_KEY=
ULTRALYTICS_MODEL_OWNER=ultralytics
ULTRALYTICS_MODEL_PROJECT=yolov8
ULTRALYTICS_MODEL_NAME=yolov8n
INFERENCE_API_URL=
INFERENCE_API_KEY=
INFERENCE_API_AUTH_HEADER=Authorization
INFERENCE_API_AUTH_SCHEME=Bearer
DEMO_UNATTENDED_SECONDS=2
DEMO_DEBOUNCE_SECONDS=0
DEMO_MAX_FRAMES=100
NEXT_PUBLIC_DEMO_FRAME_INTERVAL_MS=3000

# Dashboard sign-in: comma-separated admin emails. Links are emailed via n8n, or printed in the API console in development.
ADMIN_EMAILS=
DEV_LOGIN_LINKS=true

# AI: Claude for the chatbots (never commit the key). Local models via Ollama for embeddings and safety screening.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CHAT_MAX_OUTPUT_TOKENS_PER_CONVERSATION=20000
CHAT_MAX_TURNS_PER_CONVERSATION=20
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EVAL_MODELS=llama3.2:3b,qwen2.5:3b,mistral:7b,deepseek-r1:1.5b

# Integrations: n8n email webhook (see infra/n8n/README.md) and the bearer token for staff MCP/HTTP clients.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=change-me
MCP_HTTP_TOKEN=
DEFAULT_BRANCH_ID=gulshan
